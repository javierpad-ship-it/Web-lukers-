# Copia este archivo como .env y pon tus propios valores.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore).

# Puerto del servidor (en Railway lo asigna la plataforma automáticamente)
PORT=3000

# Dirección pública definitiva del sitio (sin barra final)
SITE_URL=https://lukers.pe

# --- Contraseñas -----------------------------------------------------
# Si no defines estas variables, el servidor genera una contraseña
# aleatoria en cada arranque y la muestra en el registro (log). El sitio
# público funciona igual, pero no podrás entrar al panel hasta definirlas.
# Mínimo 8 caracteres. Usa contraseñas largas y distintas entre sí.

# Panel de administración (/admin)
ADMIN_PASSWORD=

# Módulo de RR.HH. / postulaciones (/postulaciones)
JOBS_PASSWORD=

# Secreto para firmar las sesiones (cualquier texto largo y aleatorio).
# Si cambia, se cierran todas las sesiones abiertas.
SESSION_SECRET=

# --- Persistencia en Railway -----------------------------------------
# Crea un Volume y móntalo en /data, luego define:
# DATA_DIR=/data
# UPLOADS_DIR=/data/uploads
